// Prisma schema — SYS Gate Pass Management System

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SyncStatus {
  PENDING
  CONFIRMED
  SYNCING
  SYNCED
  FAILED
  NEEDS_REVIEW
  CANCELLED
}

model User {
  id          String   @id @default(cuid())
  credential  String   @unique  // phone number or email
  password    String            // bcrypt hash — never store plaintext
  role        String   @default("contractor")  // "contractor" | "admin"
  contactName String?           // ชื่อผู้ใช้งานจริง เพื่อให้ admin รู้ว่าบัญชีนี้ของใคร
  createdAt   DateTime @default(now())

  records Record[]
}

model Record {
  id        String  @id @default(cuid())
  name      String           // worker full name (Thai)
  idCard    String           // 13-digit Thai national ID, digits only
  company   String
  job       String?          // job title / position
  zone      String?          // work zone e.g. "Zone A", "อาคาร 2"
  startDate String           // ISO date string YYYY-MM-DD
  endDate   String           // ISO date string YYYY-MM-DD
  manDays   Int              // inclusive day count (calcMD result)
  accident  Boolean @default(false)  // admin toggles this after the fact
  createdAt String           // ISO date string YYYY-MM-DD (submission date)
  createdBy String           // User.id of submitting contractor

  syncStatus    SyncStatus @default(PENDING)
  syncAttempt   Int        @default(0)
  lastSyncError String?
  lastSyncAt    DateTime?
  syncedAt      DateTime?
  claimedAt     DateTime?
  claimedBy     String?
  batchKey      String?
  confirmedAt   DateTime?
  confirmedBy   String?
  updatedAt     DateTime   @default(now()) @updatedAt

  @@index([syncStatus])

  author User @relation(fields: [createdBy], references: [id])
}

model SyncLog {
  id         String   @id @default(cuid())
  recordId   String
  fromStatus String?
  toStatus   String
  actor      String
  machine    String?
  error      String?
  createdAt  DateTime @default(now())

  @@index([recordId, createdAt])
  @@index([createdAt])
}
