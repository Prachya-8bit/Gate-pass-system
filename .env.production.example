# Production (Vercel) — ค่าเหล่านี้ไม่ได้อ่านจากไฟล์ ให้ไปตั้งใน
# Vercel dashboard → Project → Settings → Environment Variables
# ไฟล์นี้เป็นเช็คลิสต์ว่าต้องตั้งตัวไหนบ้าง — NEVER commit real values.

# Neon PostgreSQL — ใช้ connection string แบบ "pooled" (มี -pooler ในชื่อ host)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# JWT signing secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace-with-64-char-random-hex-string"

# API key for the eprocurement integration endpoint (/api/integration/records).
# Share this only with the eprocurement IT team. Generate a different key than dev:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_API_KEY="replace-with-64-char-hex-key"

# ใช้ตอนรัน seed จากเครื่องตัวเองชี้ไป production (ไม่ต้องตั้งใน Vercel):
#   DATABASE_URL=<direct connection ของ Neon> SEED_ADMIN_PASSWORD=<รหัสจริง> npx prisma db seed
# SEED_ADMIN_PASSWORD="strong-admin-password"
