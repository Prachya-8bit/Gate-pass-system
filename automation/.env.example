# คัดลอกไฟล์นี้เป็น .env (ห้าม commit .env — ถูก ignore ไว้แล้ว)

# บัญชี epro ของคุณ — สคริปต์ใช้ log-in แทนคุณ
EPRO_USERNAME="your-epro-username"
EPRO_PASSWORD="your-epro-password"

# Plant: 4911 = SYS-MTP, 4931 = SYS-HP, 4951 = SYS-BDC
EPRO_PLANT="4911"

# ผู้อนุมัติ (ddlSM) — ใส่ value ตัวเลข เช่น 6=นายอนุสรณ์ (SM), 10=นายเอนก (SM),
# 200=นายอรรคเทพ (PM), 317=นายปิยะ (DM) — ดูรายชื่อเต็มในหน้า FrmWorker.aspx
EPRO_APPROVER=""

# เบอร์โทรผู้ขอ (ไม่บังคับ — เว้นว่างได้ถ้าระบบไม่บังคับกรอก)
EPRO_REQ_TEL=""

# Gate Pass ที่รันอยู่ (dev server ในเครื่อง)
GATEPASS_URL="http://localhost:4009"

# ค่าเดียวกับ INTEGRATION_API_KEY ใน .env.local ของโปรเจกต์หลัก
INTEGRATION_API_KEY="copy-from-project-.env.local"
