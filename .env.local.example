# Local development — copy to .env.local (Next.js loads it automatically).
#
# PostgreSQL (Neon) — ใช้ branch "dev" ของ Neon สำหรับเครื่องพัฒนา
# (อย่าชี้เครื่อง dev ไปที่ branch production) Set up with:
#   npx prisma migrate deploy
#   npx prisma db seed

DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
JWT_SECRET="dev-only-secret-change-in-production"

# API key for the eprocurement integration endpoint (/api/integration/records).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_API_KEY="replace-with-64-char-hex-key"
